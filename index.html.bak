<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>名片掃描器</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<h1>名片掃描器 <span id="version">v3.1111</span></h1>
<video id="preview" autoplay playsinline style="width:100%;max-width:400px;border:1px solid #ccc;"></video>
<br>
<button id="captureBtn">拍照</button>
<div id="result" style="margin-top:1em;"></div>
<a id="downloadLink" download="contact.vcard" style="display:none;">下載 vCard</a>

<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5"></script>
<script src="script.js"></script>
</body>
</html>